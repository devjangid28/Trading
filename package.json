{
  "name": "orderflow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "OrderFlow — live order block, liquidity and news-impact terminal for crypto and Indian markets",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check:universe": "tsx scripts/universe-check.ts",
    "probe": "tsx scripts/probe-sources.ts",
    "fixtures": "tsx scripts/capture-fixtures.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test",
    "verify:ledger": "tsx scripts/verify-ledger.ts",

    "preview": "vite preview",
    "start": "tsx server/src/index.ts"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true
  }
}
