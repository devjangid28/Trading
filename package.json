{
  "name": "orderflow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "OrderFlow — live order block, liquidity and news-impact terminal for crypto and Indian markets",
  "scripts": {
    "predev": "tsx scripts/free-dev-ports.ts",
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check:universe": "tsx scripts/universe-check.ts",
    "probe": "tsx scripts/probe-sources.ts",
    "fixtures": "tsx scripts/capture-fixtures.ts",
    "record-fixtures": "tsx scripts/record-fixtures.ts",
    "dev:mock": "concurrently -n api-mock,web -c yellow,cyan \"npm:dev:api:mock\" \"npm:dev:web\"",
    "dev:api:mock": "tsx server/scripts/dev-mock.ts",
    "prove:supervisor": "tsx server/scripts/prove-supervisor.ts",
    "prove:mock": "tsx server/scripts/prove-mock.ts",
    "plan:workings": "tsx scripts/print-plan-workings.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test",
    "verify:ledger": "tsx scripts/verify-ledger.ts",
    "ledger:stats": "tsx scripts/ledger-stats.ts",
    "engine:baseline": "tsx scripts/engine-baseline.ts",
    "verify:engine": "tsx scripts/verify-engine.ts",
    "mind:report": "tsx scripts/mind-report.ts",
    "xvi:report": "tsx scripts/xvi-report.ts",
    "verify:stage1": "tsx scripts/verify-stage1.ts",
    "verify:truth": "tsx scripts/verify-truth.ts",
    "prove:ban": "tsx server/scripts/prove-ban-guard.ts",
    "start:forever": "tsx server/scripts/supervisor.ts",
    "preview": "vite preview",
    "start": "tsx server/src/index.ts"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "express": "^4.21.2",
    "klinecharts": "^9.8.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true
  }
}
