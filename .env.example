# Copy to .env — every value is OPTIONAL. The app runs fully without any of them.
# Only add a CoinGecko demo key if you want higher rate limits (100/min vs ~30/min).

# Free CoinGecko demo key: https://www.coingecko.com/en/api
COINGECKO_DEMO_KEY=

# Server port (Vite proxies /api here)
PORT=8787

# Split deployment: when the UI and the engine live on different origins
# (e.g. frontend on Vercel, engine on Railway), set this to the EXACT
# frontend origin (https://<your-app>.vercel.app) so cross-origin API calls
# and the SSE price stream are allowed. Omit for same-origin (default).
ALLOWED_ORIGIN=

# Frontend-only: absolute base URL of the engine for a split deployment,
# e.g. https://<engine>.up.railway.app. Omit for same-origin (default).
# VITE_API_BASE=https://<engine>.up.railway.app
